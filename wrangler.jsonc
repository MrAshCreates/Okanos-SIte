{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okanos-site",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "okanos.app", "custom_domain": true, "zone_name": "okanos.app" },
    { "pattern": "okanos.mrashcreates.xyz", "custom_domain": true, "zone_name": "mrashcreates.xyz" }
  ]
}
